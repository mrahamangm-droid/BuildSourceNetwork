# ── Database (PostgreSQL) ─────────────────────────────────────────
# Pooled connection used by the app at runtime (e.g. Supabase pooler / Neon pooled URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Direct (non-pooled) connection used only by `prisma migrate deploy` (optional; falls back to DATABASE_URL)
DIRECT_URL=""
# Max pool size per server instance (default 5; keep low on serverless)
DATABASE_POOL_MAX="5"

# ── Auth.js ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (REQUIRED in production)
AUTH_SECRET=""
# Public site URL, no trailing slash (used in emails, canonical URLs, sitemap)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email ─────────────────────────────────────────────────────────
# "resend" to send real mail; anything else logs mail to the server console (development)
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM="Building Materials Network <no-reply@yourdomain.com>"

# ── File storage (logos, covers, product images) ──────────────────
# Supabase Storage (public bucket). Leave empty in local dev to store files in apps/web/.uploads
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="public-assets"

# ── Cron ──────────────────────────────────────────────────────────
# Shared secret for /api/cron/expire (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# ── Seed (development only) ───────────────────────────────────────
SEED_DEMO_PASSWORD="Demo@12345"
SEED_ADMIN_EMAIL="admin@demo.bmn.example"
