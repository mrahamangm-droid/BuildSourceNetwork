// Building Materials Network — multi-tenant schema.
// Tenancy rule: every private row carries an organization id (buyerOrgId / supplierOrgId / orgId)
// and every query in the app goes through org-scoped helpers (see apps/web/src/server/access.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrgType {
  SUPPLIER
  STORE
  CONTRACTOR
  BUYER
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  ON_REQUEST
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum RfqStatus {
  OPEN
  ACCEPTED
  CLOSED
  EXPIRED
  CANCELLED
}

enum RecipientStatus {
  SENT
  VIEWED
  RESPONDED
  DECLINED
  EXPIRED
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum OrderStatus {
  ORDER_CREATED
  CONFIRMED
  PREPARING
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String
  emailVerifiedAt DateTime?
  isPlatformAdmin Boolean   @default(false)
  isDemo          Boolean   @default(false)
  notifyEmail     Boolean   @default(true)
  notifyInApp     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   OrganizationMember[]
  tokens        AuthToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Organization {
  id                 String             @id @default(cuid())
  type               OrgType
  name               String
  slug               String             @unique
  description        String?
  logoUrl            String?
  coverUrl           String?
  phone              String?
  email              String?
  website            String?
  addressLine        String?
  city               String?
  region             String?
  country            String             @default("AE")
  currency           String             @default("AED")
  businessHours      String?
  deliveryAreas      String[]
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isActive           Boolean            @default(true)
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  categories   Category[]
  members      OrganizationMember[]
  branches     Branch[]
  products     Product[]
  subscription Subscription?
  verificationRequests VerificationRequest[]
  inventoryItems       InventoryItem[]
  stockMovements       StockMovement[]

  rfqs            Rfq[]              @relation("BuyerRfqs")
  recipients      RfqRecipient[]
  quotes          Quote[]
  buyerOrders     Order[]            @relation("BuyerOrders")
  supplierOrders  Order[]            @relation("SupplierOrders")
  reviewsWritten  Review[]           @relation("ReviewAuthor")
  reviewsReceived Review[]           @relation("ReviewSubject")
  documents       Document[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([type, isActive])
  @@index([city])
}

model OrganizationMember {
  id        String     @id @default(cuid())
  userId    String
  orgId     String
  role      MemberRole @default(STAFF)
  createdAt DateTime   @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Branch {
  id         String       @id @default(cuid())
  orgId      String
  name       String
  city       String?
  address    String?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]

  @@index([orgId])
}

model Warehouse {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items     InventoryItem[]
  movements StockMovement[]

  @@index([branchId])
}

model Category {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  sortOrder     Int            @default(0)
  products      Product[]
  organizations Organization[]
  rfqItems      RfqItem[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

// Units are rows, not enum values, so new units and conversions need no migration.
model Unit {
  code      String @id
  name      String
  dimension String
  baseCode  String
  factor    Decimal @db.Decimal(20, 6)

  products      Product[]
  rfqItems      RfqItem[]
  orderItems    OrderItem[]
}

model Product {
  id               String       @id @default(cuid())
  orgId            String
  categoryId       String
  brandId          String?
  unitCode         String
  sku              String?
  name             String
  slug             String
  description      String?
  specifications   Json?
  packageSize      String?
  minOrderQty      Decimal      @default(1) @db.Decimal(14, 3)
  stockStatus      StockStatus  @default(IN_STOCK)
  price            Decimal      @db.Decimal(14, 2)
  wholesalePrice   Decimal?     @db.Decimal(14, 2)
  contractorPrice  Decimal?     @db.Decimal(14, 2)
  vatRatePercent   Decimal      @default(5) @db.Decimal(5, 2)
  currency         String       @default("AED")
  city             String?
  deliveryAvailable Boolean     @default(true)
  isActive         Boolean      @default(true)
  isDemo           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category Category       @relation(fields: [categoryId], references: [id])
  brand    Brand?         @relation(fields: [brandId], references: [id])
  unit     Unit           @relation(fields: [unitCode], references: [code])
  images   ProductImage[]
  prices   PriceHistory[]
  rfqItems RfqItem[]
  inventory InventoryItem[]
  movements StockMovement[]

  @@unique([orgId, slug])
  @@unique([orgId, sku])
  @@index([categoryId, isActive])
  @@index([orgId, isActive])
  @@index([city])
  @@index([name])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  price     Decimal  @db.Decimal(14, 2)
  tier      String   @default("RETAIL")
  changedAt DateTime @default(now())
  changedBy String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, changedAt])
}

model Rfq {
  id              String    @id @default(cuid())
  number          String    @unique
  buyerOrgId      String
  createdById     String
  title           String?
  deliveryCity    String
  deliveryAddress String?
  requiredDate    DateTime?
  notes           String?
  status          RfqStatus @default(OPEN)
  isGetQuotes     Boolean   @default(false)
  targetSupplierCount Int   @default(3)
  expiresAt       DateTime
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  buyerOrg   Organization   @relation("BuyerRfqs", fields: [buyerOrgId], references: [id], onDelete: Cascade)
  items      RfqItem[]
  recipients RfqRecipient[]
  quotes     Quote[]
  orders     Order[]

  @@index([buyerOrgId, status])
  @@index([status, expiresAt])
}

model RfqItem {
  id            String   @id @default(cuid())
  rfqId         String
  categoryId    String?
  productId     String?
  name          String
  quantity      Decimal  @db.Decimal(14, 3)
  unitCode      String
  specification String?
  rfq           Rfq        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  category      Category?  @relation(fields: [categoryId], references: [id])
  product       Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  unit          Unit       @relation(fields: [unitCode], references: [code])
  quoteItems    QuoteItem[]

  @@index([rfqId])
}

// One row per supplier the RFQ was sent to; carries the Sent / Viewed / Responded / Expired status.
model RfqRecipient {
  id            String          @id @default(cuid())
  rfqId         String
  supplierOrgId String
  status        RecipientStatus @default(SENT)
  viewedAt      DateTime?
  respondedAt   DateTime?
  createdAt     DateTime        @default(now())
  rfq           Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierOrg   Organization    @relation(fields: [supplierOrgId], references: [id], onDelete: Cascade)

  @@unique([rfqId, supplierOrgId])
  @@index([supplierOrgId, status])
}

// A supplier's quotation in response to an RFQ (one per supplier per RFQ).
model Quote {
  id            String      @id @default(cuid())
  rfqId         String
  supplierOrgId String
  status        QuoteStatus @default(SUBMITTED)
  deliveryDays  Int?
  deliveryCost  Decimal     @default(0) @db.Decimal(14, 2)
  validUntil    DateTime
  notes         String?
  currency      String      @default("AED")
  totalAmount   Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  rfq         Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierOrg Organization @relation(fields: [supplierOrgId], references: [id], onDelete: Cascade)
  items       QuoteItem[]
  order       Order?

  @@unique([rfqId, supplierOrgId])
  @@index([supplierOrgId, status])
}

model QuoteItem {
  id                String  @id @default(cuid())
  quoteId           String
  rfqItemId         String
  unitPrice         Decimal @db.Decimal(14, 2)
  quantityAvailable Decimal @db.Decimal(14, 3)
  minOrderQty       Decimal @default(1) @db.Decimal(14, 3)
  notes             String?
  quote             Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItem           RfqItem @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)

  @@unique([quoteId, rfqItemId])
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  buyerOrgId      String
  supplierOrgId   String
  rfqId           String?
  quoteId         String?     @unique
  createdById     String
  status          OrderStatus @default(ORDER_CREATED)
  currency        String      @default("AED")
  subtotal        Decimal     @db.Decimal(14, 2)
  deliveryCost    Decimal     @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal     @db.Decimal(14, 2)
  platformFeeBps  Int         @default(100)
  deliveryCity    String?
  deliveryAddress String?
  requiredDate    DateTime?
  notes           String?
  isDemo          Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyerOrg    Organization @relation("BuyerOrders", fields: [buyerOrgId], references: [id])
  supplierOrg Organization @relation("SupplierOrders", fields: [supplierOrgId], references: [id])
  rfq         Rfq?         @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  quote       Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  events      OrderEvent[]
  deliveries  Delivery[]
  reviews     Review[]

  @@index([buyerOrgId, status])
  @@index([supplierOrgId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  name      String
  quantity  Decimal @db.Decimal(14, 3)
  unitCode  String
  unitPrice Decimal @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  unit      Unit    @relation(fields: [unitCode], references: [code])

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Delivery {
  id            String         @id @default(cuid())
  orderId       String
  status        DeliveryStatus @default(PENDING)
  driverName    String?
  vehicle       String?
  scheduledAt   DateTime?
  deliveredAt   DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Reviews are only possible on a COMPLETED order and only by the buyer org; one per order.
model Review {
  id           String   @id @default(cuid())
  orderId      String   @unique
  authorOrgId  String
  subjectOrgId String
  authorId     String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorOrg    Organization @relation("ReviewAuthor", fields: [authorOrgId], references: [id])
  subjectOrg   Organization @relation("ReviewSubject", fields: [subjectOrgId], references: [id])

  @@index([subjectOrgId])
}

model Notification {
  id        String        @id @default(cuid())
  userId    String
  orgId     String?
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Document {
  id          String       @id @default(cuid())
  orgId       String
  kind        String
  url         String
  filename    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model SubscriptionPlan {
  code              String         @id
  name              String
  priceMonthlyCents Int?
  productLimit      Int?
  rfqLimit          Int?
  features          String[]
  isActive          Boolean        @default(true)
  subscriptions     Subscription[]
}

model Subscription {
  id                String           @id @default(cuid())
  orgId             String           @unique
  planCode          String
  status            String           @default("ACTIVE")
  provider          String?
  providerRef       String?
  currentPeriodEnd  DateTime?
  createdAt         DateTime         @default(now())
  org               Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan @relation(fields: [planCode], references: [code])
}

// A company's application to become a "Verified business". Admin reviews it; approving sets
// Organization.verificationStatus = VERIFIED. Demo organizations are never verified.
model VerificationRequest {
  id               String             @id @default(cuid())
  orgId            String
  status           VerificationStatus @default(PENDING)
  legalName        String
  licenseNumber    String
  licenseAuthority String?
  licenseDocUrl    String?
  taxNumber        String?
  notes            String?
  submittedById    String
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime           @default(now())
  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([status, createdAt])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String        @id @default(cuid())
  orgId     String?
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime      @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([actorId])
}

// Stock is tracked per warehouse and product. onHand and reserved are only ever changed through
// services/inventory.ts, which writes a StockMovement row in the same transaction.
// available = onHand - reserved; a check constraint in the migration keeps 0 <= reserved <= onHand.
model InventoryItem {
  id           String    @id @default(cuid())
  orgId        String
  warehouseId  String
  productId    String
  onHand       Decimal   @default(0) @db.Decimal(14, 3)
  reserved     Decimal   @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal   @default(0) @db.Decimal(14, 3)
  updatedAt    DateTime  @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([orgId, productId])
}

// Append-only ledger. quantity fields are signed deltas; onHandAfter is the balance after the change.
model StockMovement {
  id           String            @id @default(cuid())
  orgId        String
  warehouseId  String
  productId    String
  type         StockMovementType
  onHandDelta  Decimal           @default(0) @db.Decimal(14, 3)
  reservedDelta Decimal          @default(0) @db.Decimal(14, 3)
  onHandAfter  Decimal           @db.Decimal(14, 3)
  unitCost     Decimal?          @db.Decimal(14, 2)
  reference    String?
  note         String?
  actorId      String?
  createdAt    DateTime          @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([productId, createdAt])
}
